# NetLet configuration.
#
# Copy to `.env` and fill in. Nothing here throws at boot — the server starts
# with an empty file — but each unset variable disables a specific feature, and
# the tiers below say which. Every value is a secret except where noted; commit
# none of them.
#
# VITE_-prefixed values are inlined into the client bundle at build time and are
# therefore PUBLIC. Never put a secret behind a VITE_ name.

# ---------------------------------------------------------------------------
# Tier 1 — the storefront. Without these there is no catalog at all: every
# product, collection and cart call fails with "Shopify Storefront API is not
# configured", which is most of the site.
# ---------------------------------------------------------------------------

# Your myshopify domain, no scheme. e.g. netlet.myshopify.com
SHOPIFY_STORE_DOMAIN=

# Storefront API access token — NOT an Admin API token. Shopify admin ->
# Settings -> Apps and sales channels -> Develop apps -> your app ->
# Configuration -> Storefront API. Needs at minimum:
#   unauthenticated_read_product_listings
#   unauthenticated_read_product_inventory
#   unauthenticated_write_checkouts   (cart create / update)
# The adapter pins Storefront API version 2025-04 (server/_core/shopify.ts).
SHOPIFY_STOREFRONT_API_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Tier 2 — accounts. Without these the site still sells: browsing, cart and
# checkout work as a guest. Sign-in, saved items, delivery preference and order
# tracking are what go dark, and they fail quietly rather than loudly — db.ts
# returns null and the customer procedures no-op.
# ---------------------------------------------------------------------------

# MySQL connection string, e.g. mysql://user:pass@host:3306/netlet
# Provision the schema with: pnpm db:push
DATABASE_URL=

# Secret used to sign session cookies. Generate a long random value, e.g.
#   openssl rand -base64 48
JWT_SECRET=

# OAuth provider. NOTE: the bundled SDK targets Manus's auth service
# (webdev.v1.WebDevAuthPublicService). If NetLet is hosted off the Manus
# platform this provider may not be available, and server/_core/sdk.ts +
# oauth.ts would need pointing at a different one.
OAUTH_SERVER_URL=
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=

# openId of the account that should receive the 'admin' role on sign-in.
OWNER_OPEN_ID=

# ---------------------------------------------------------------------------
# Tier 3 — optional. Each degrades cleanly; nothing else breaks when unset.
# ---------------------------------------------------------------------------

# AI search refinement. Unset, the refine call returns PRECONDITION_FAILED and
# the storefront falls back to local catalog filtering, which still works.
MISTRAL_API_KEY=

# Manus Forge storage, behind the /manus-storage proxy: brand imagery and voice
# transcription. Off-platform these will not exist — brandAssets.ts already
# falls back to committed files in client/public/brand for the static build.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Umami analytics. Both are inlined into index.html, so both are public. Unset,
# the tag ships with its placeholders unsubstituted and fires one broken
# request per page load — the Pages workflow strips it for that reason.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# ---------------------------------------------------------------------------
# Build-time flags (not secrets)
# ---------------------------------------------------------------------------

# Serve the app from a sub-path, e.g. /NetLet-web-app/ for a GitHub Pages
# project site. Unset means the domain root.
# VITE_BASE_PATH=

# Build the fixture-backed static demo with no backend: tRPC resolves from
# client/src/lib/demoLink.ts. Leave unset for a real deployment.
# VITE_DEMO_MODE=

# Force the Manus editor tooling into a production build. Leave unset; it
# inlines ~367KB into index.html.
# MANUS_RUNTIME=

# Server port. Defaults to 3000.
# PORT=
