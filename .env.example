# NetLet configuration.
#
# Copy to `.env` and fill in. Nothing here throws at boot — the server starts on
# an empty file — so an unset variable disables a feature rather than preventing
# startup. The tiers below say which.
#
# VITE_-prefixed values are inlined into the client bundle at build time and are
# therefore PUBLIC. Never put a secret behind a VITE_ name.

# ---------------------------------------------------------------------------
# Tier 1 — the storefront. Without these there is no catalog: every product,
# collection and cart call fails with "Shopify Storefront API is not
# configured", which is most of the site.
# ---------------------------------------------------------------------------

# Your myshopify domain, no scheme. e.g. netlet.myshopify.com
SHOPIFY_STORE_DOMAIN=

# Storefront API access token — NOT an Admin API token. Shopify admin ->
# Settings -> Apps and sales channels -> Develop apps -> your app ->
# Configuration -> Storefront API. Needs at minimum:
#   unauthenticated_read_product_listings
#   unauthenticated_read_product_inventory
#   unauthenticated_write_checkouts   (cart create / update)
# The adapter pins Storefront API version 2025-04 (server/_core/shopify.ts).
SHOPIFY_STOREFRONT_API_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Tier 2 — accounts. Without these the site still sells: browsing, cart and
# checkout all work as a guest. Sign-in, saved items, delivery preference and
# order tracking are what go dark.
#
# Authentication is first-party: email and password against NetLet's own users
# table, hashed with scrypt. There is no identity provider to register with and
# no client id to obtain.
# ---------------------------------------------------------------------------

# MySQL connection string, e.g. mysql://user:pass@host:3306/netlet
# Provision the schema with: pnpm db:push
DATABASE_URL=

# Signs session cookies (HS256, via jose). Required before any sign-in works.
# Generate with:  openssl rand -base64 48
# Rotating it invalidates every existing session, which is the intended way to
# sign everyone out.
JWT_SECRET=

# Address granted the admin role when it registers. Optional.
OWNER_EMAIL=

# ---------------------------------------------------------------------------
# Tier 3 — optional. Each degrades cleanly; nothing else breaks when unset.
# ---------------------------------------------------------------------------

# AI search refinement. Unset, the refine call returns PRECONDITION_FAILED and
# the storefront falls back to local catalog filtering, which still works.
MISTRAL_API_KEY=

# Umami analytics. Both are inlined into index.html, so both are public. Unset,
# the tag ships with its placeholders unsubstituted and fires one broken request
# per page load — the Pages workflow strips it for that reason.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# ---------------------------------------------------------------------------
# Build-time flags (not secrets)
# ---------------------------------------------------------------------------

# Serve from a sub-path, e.g. /NetLet-web-app/ for a GitHub Pages project site.
# Unset means the domain root.
# VITE_BASE_PATH=

# Build the fixture-backed static demo with no backend: tRPC resolves from
# client/src/lib/demoLink.ts. Leave unset for a real deployment.
# VITE_DEMO_MODE=

# Server port. Defaults to 3000.
# PORT=
