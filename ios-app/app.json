{
  "expo": {
    "name": "NetLet",
    "slug": "netlet",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "netlet",
    "icon": "./assets/icon.png",
    "primaryColor": "#0a285a",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.netlet.marketplace",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0a285a"
        }
      ]
    ],
    "assetBundlePatterns": ["**/*"]
  }
}
